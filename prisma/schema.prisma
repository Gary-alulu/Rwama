datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  FACTORY_MANAGER
  FARMER
  BUYER
}

enum CherryGrade {
  A
  B
  MBUNI
}

enum CoffeeGrade {
  AA
  AB
  PB
  C
  E
  TT
  T
}

enum ProcessingMethod {
  WASHED
  NATURAL
  HONEY
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(BUYER)
  accounts      Account[]
  sessions      Session[]
  
  farmerProfile        FarmerProfile?
  buyerProfile         BuyerProfile?
  factoryManagerProfile FactoryManagerProfile?
  passwordHash         String?
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Factory {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  location           String
  altitudeMeters     Int
  yearEstablished    Int
  processingCapacity Int
  totalFarmers       Int
  certifications     String[]
  description        String
  latitude           Float?
  longitude          Float?
  
  managers           FactoryManagerProfile[]
  farmers            FarmerProfile[]
  deliveryLogs       DeliveryLog[]
  batches            ProcessingBatch[]
}

model FarmerProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  farmerId      String   @unique
  nationalId    String   @unique
  phoneNumber   String?
  locationZone  String?
  farmSizeAcres Float?
  joinedYear    Int?
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  factoryId     String
  factory       Factory  @relation(fields: [factoryId], references: [id])
  deliveryLogs  DeliveryLog[]
}

model FactoryManagerProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  employeeId String   @unique
  factoryId  String
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  factory    Factory  @relation(fields: [factoryId], references: [id])
}

model BuyerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String?
  country     String?
  licenseNo   String?
  isVerified  Boolean  @default(false)
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeliveryLog {
  id           String      @id @default(cuid())
  weightKg     Float
  cherryGrade  CherryGrade
  deliveryDate DateTime    @default(now())
  
  farmerId     String
  farmer       FarmerProfile @relation(fields: [farmerId], references: [id])
  factoryId    String
  factory      Factory       @relation(fields: [factoryId], references: [id])
}

model CoffeeLot {
  id              String      @id @default(cuid())
  traceabilityId  String      @unique
  grade           CoffeeGrade
  scaScore        Float
  moisturePercent Float
  screenSize      String?
  weightKg        Float
  numberOfBags    Int
  flavorProfile   String[]
  cuppingNotes    Json?
  priceUsdKg      Float
  cropYear        Int
  isAvailable     Boolean     @default(true)
  
  links           TraceabilityLink[]
}

model ProcessingBatch {
  id                String           @id @default(cuid())
  batchCode         String           @unique
  method            ProcessingMethod
  totalWeightKg     Float
  processingDate    DateTime
  dryingDays        Int
  fermentationHours Int
  
  factoryId         String
  factory           Factory          @relation(fields: [factoryId], references: [id])
  
  links             TraceabilityLink[]
}

model TraceabilityLink {
  coffeeLotId       String
  processingBatchId String
  contributionPct   Float
  
  coffeeLot         CoffeeLot       @relation(fields: [coffeeLotId], references: [id])
  processingBatch   ProcessingBatch @relation(fields: [processingBatchId], references: [id])
  
  @@id([coffeeLotId, processingBatchId])
}
